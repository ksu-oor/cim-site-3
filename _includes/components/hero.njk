<section class="tile tile-hero" aria-label="CIM Hero">
      <div class="tile-hero__label">{{ hero.label | safe }}</div>
      <h1 class="tile-hero__title">{{ hero.title | safe }}</h1>
      <p class="tile-hero__subtitle">{{ hero.subtitle | safe }}</p>
      <p class="tile-hero__desc">{{ hero.description | safe }}</p>
      <a href="{{ hero.ctaHref }}" class="btn-primary tile-hero__cta">{{ hero.ctaText | safe }}</a>
    </section>
