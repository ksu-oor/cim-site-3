              </svg>
            </div>
            <a href="mailto:cim@kennesaw.edu" class="btn-primary touch-cta">START A CONVERSATION</a>
          </div>
        </article>

        <article class="slide slide--touch" data-slide-index="1">
          <div class="tile-label slide__label">LINKEDIN</div>
          <div class="slide__body slide__body--touch">
            <div class="touch-primary-block">
              <p class="touch-handle touch-handle--xl">@ksu-cim</p>
            </div>
            <div class="touch-decoration touch-decoration--mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
              </svg>
            </div>
            <a href="https://www.linkedin.com/showcase/ksu-cim/" target="_blank" rel="noopener noreferrer" class="arrow-pill arrow-pill--interactive">
              <span>FOLLOW</span>
              <span class="arrow-pill__arrow">→</span>
            </a>
          </div>
        </article>

        <article class="slide slide--touch" data-slide-index="2">
          <div class="tile-label slide__label">VISIT</div>
          <div class="slide__body slide__body--touch">
            <div class="touch-primary-block">
              <div class="touch-venue">Shore Innovation Center</div>
            </div>
            <address class="touch-address">
              <span style="display:block">970 Technology Way</span>
              <span style="display:block">Marietta, GA 30060</span>
              <span style="display:block">KSU Marietta Campus</span>
            </address>
          </div>
        </article>

      </div>
      <div class="spotlight__controls" role="group" aria-label="Contact spotlight controls">
        <button class="spot-btn spot-btn--prev" type="button" aria-label="Previous contact slide">‹</button>
        <div class="spot-dots" role="tablist" aria-label="Contact slides">
          <button class="spot-dot" role="tab" aria-selected="true" aria-label="Slide 1 of 3: Email" data-dot="0"></button>
          <button class="spot-dot" role="tab" aria-selected="false" aria-label="Slide 2 of 3: LinkedIn" data-dot="1"></button>
          <button class="spot-dot" role="tab" aria-selected="false" aria-label="Slide 3 of 3: Visit" data-dot="2"></button>
        </div>
        <button class="spot-btn spot-btn--next" type="button" aria-label="Next contact slide">›</button>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-clusters">GAME STUDIO · DIGITAL TWIN · XR &amp; HEALTHCARE · IMMERSIVE ED · DIGITAL HUMANITIES</span>
      <span class="footer-links">
        <a href="accessibility.html">ACCESSIBILITY</a>
      </span>
      <span class="footer-copy">&copy; 2026 Center for Interactive Media, Kennesaw State University</span>
    </div>
  </footer>

  <script>
    // Theme toggle
    (function() {
      var toggle = document.getElementById('themeToggle');
      var html = document.documentElement;
      var label = toggle.querySelector('.theme-toggle__label');

      var saved = localStorage.getItem('cim-theme');
      if (saved === 'light') {
        html.setAttribute('data-theme', 'light');
        label.textContent = 'LIGHT';
      }

      toggle.addEventListener('click', function() {
        var current = html.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        label.textContent = next === 'light' ? 'LIGHT' : 'DARK';
        localStorage.setItem('cim-theme', next);
      });

      // Post-event state
      var eventTile = document.querySelector('.tile-event');
      if (eventTile) {
        var eventDate = new Date('2026-04-27T23:59:59');
        if (new Date() > eventDate) eventTile.classList.add('tile-event--past');
      }
    })();
  </script>

  <!-- Spotlight carousel controller -->
  <script src="spotlight.js" defer></script>
{% endblock %}
