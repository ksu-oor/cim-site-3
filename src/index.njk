{% extends "layout.njk" %}

{% set title = "CIM — Center for Interactive Media · Kennesaw State University" %}
{% set description = "Kennesaw State University's Center for Interactive Media — Game Studio, Digital Twin, XR Healthcare, Immersive Education, and Digital Humanities research." %}

{% block head %}
  <link rel="stylesheet" href="styles.css">
  <script>
    // Prevent FOUC: apply saved theme before first paint
    (function(){
      var t=localStorage.getItem('cim-theme');if(t)document.documentElement.setAttribute('data-theme',t);
    })();
  </script>
{% endblock %}

{% block body %}

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Page-level toolbar: theme -->
  <div class="page-toolbar" role="toolbar" aria-label="Display settings">
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark and light mode" title="Toggle theme">
      <span class="theme-toggle__track">
        <span class="theme-toggle__knob"></span>
      </span>
      <span class="theme-toggle__label" aria-hidden="true">DARK</span>
    </button>
  </div>

  <main id="main-content" class="bento-grid">

    <!-- FIXED: HERO -->
    {% include "components/hero.njk" %}

    <!-- ROTATING: SPOTLIGHT A — RESEARCH (5 slides) -->
    {% set spot = "research" %}
    {% set spotData = spotlights.research %}
    {% include "components/spotlight.njk" %}

    <!-- FIXED: LAUNCH EVENT -->
    <a href="event.html" class="tile tile-event" aria-label="CIM Launch Event — April 27, 2026">
      <div class="tile-label">LAUNCH EVENT</div>
      <div class="tile-event__date">APR 27</div>
      <div class="tile-event__details">
        <span>9 AM – 2 PM</span>
        <span>Shore Innovation Center</span>
        <span>Marietta, GA</span>
      </div>
      <div class="tile-event__sponsors">AWS · UNITY · SGR LAW</div>
      <div class="tile-event__cta arrow-pill arrow-pill--accent" aria-hidden="true">
        <span>VIEW PROGRAM</span>
        <span class="arrow-pill__arrow">→</span>
      </div>
    </a>

    <!-- ROTATING: SPOTLIGHT B — SHOWCASE (6 slides) -->
    {% set spot = "showcase" %}
    {% set spotData = spotlights.showcase %}
    {% include "components/spotlight.njk" %}

    <!-- ROTATING: TOUCHPOINT (3 slides) -->
    <section class="spotlight spotlight--touchpoint tile" data-spotlight="touchpoint"
             role="region" aria-roledescription="carousel" aria-label="Contact touchpoint">
      <div class="spotlight__stage" aria-live="off">

        <article class="slide slide--touch" data-slide-index="0" data-active>
          <div class="tile-label slide__label">EMAIL</div>
          <div class="slide__body slide__body--touch">
            <div class="touch-primary-block">
              <a href="mailto:cim@kennesaw.edu" class="touch-primary touch-primary--large">cim@kennesaw.edu</a>
            </div>
            <div class="touch-decoration touch-decoration--qr" aria-hidden="true">
              <svg viewBox="0 0 29 29" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
                <path d="M2 2h7v1h-7zM14 2h1v1h-1zM18 2h1v1h-1zM20 2h7v1h-7zM2 3h1v1h-1zM8 3h1v1h-1zM14 3h1v1h-1zM17 3h2v1h-2zM20 3h1v1h-1zM26 3h1v1h-1zM2 4h1v1h-1zM4 4h3v1h-3zM8 4h1v1h-1zM10 4h1v1h-1zM14 4h1v1h-1zM16 4h1v1h-1zM20 4h1v1h-1zM22 4h3v1h-3zM26 4h1v1h-1zM2 5h1v1h-1zM4 5h3v1h-3zM8 5h1v1h-1zM10 5h2v1h-2zM13 5h1v1h-1zM15 5h4v1h-4zM20 5h1v1h-1zM22 5h3v1h-3zM26 5h1v1h-1zM2 6h1v1h-1zM4 6h3v1h-3zM8 6h1v1h-1zM10 6h1v1h-1zM12 6h3v1h-3zM16 6h1v1h-1zM18 6h1v1h-1zM20 6h1v1h-1zM22 6h3v1h-3zM26 6h1v1h-1zM2 7h1v1h-1zM8 7h1v1h-1zM10 7h2v1h-2zM13 7h6v1h-6zM20 7h1v1h-1zM26 7h1v1h-1zM2 8h7v1h-7zM10 8h1v1h-1zM12 8h1v1h-1zM14 8h1v1h-1zM16 8h1v1h-1zM18 8h1v1h-1zM20 8h7v1h-7zM10 9h2v1h-2zM13 9h1v1h-1zM16 9h3v1h-3zM2 10h1v1h-1zM4 10h5v1h-5zM12 10h2v1h-2zM15 10h1v1h-1zM17 10h1v1h-1zM20 10h5v1h-5zM3 11h1v1h-1zM5 11h3v1h-3zM10 11h2v1h-2zM13 11h3v1h-3zM18 11h1v1h-1zM21 11h1v1h-1zM23 11h2v1h-2zM3 12h3v1h-3zM7 12h2v1h-2zM10 12h1v1h-1zM14 12h4v1h-4zM19 12h1v1h-1zM21 12h1v1h-1zM25 12h2v1h-2zM7 13h1v1h-1zM10 13h3v1h-3zM14 13h1v1h-1zM18 13h3v1h-3zM22 13h1v1h-1zM25 13h2v1h-2zM3 14h1v1h-1zM6 14h3v1h-3zM13 14h4v1h-4zM19 14h2v1h-2zM22 14h3v1h-3zM26 14h1v1h-1zM2 15h1v1h-1zM5 15h1v1h-1zM9 15h4v1h-4zM18 15h1v1h-1zM20 15h2v1h-2zM24 15h1v1h-1zM2 16h1v1h-1zM4 16h6v1h-6zM13 16h2v1h-2zM16 16h2v1h-2zM20 16h4v1h-4zM25 16h2v1h-2zM2 17h1v1h-1zM5 17h1v1h-1zM13 17h1v1h-1zM16 17h1v1h-1zM18 17h1v1h-1zM20 17h1v1h-1zM25 17h2v1h-2zM2 18h1v1h-1zM5 18h1v1h-1zM8 18h2v1h-2zM13 18h1v1h-1zM15 18h2v1h-2zM18 18h5v1h-5zM24 18h2v1h-2zM10 19h3v1h-3zM14 19h1v1h-1zM17 19h2v1h-2zM22 19h1v1h-1zM2 20h7v1h-7zM11 20h1v1h-1zM16 20h1v1h-1zM18 20h1v1h-1zM20 20h1v1h-1zM22 20h2v1h-2zM25 20h2v1h-2zM2 21h1v1h-1zM8 21h1v1h-1zM10 21h3v1h-3zM14 21h1v1h-1zM18 21h1v1h-1zM22 21h1v1h-1zM25 21h1v1h-1zM2 22h1v1h-1zM4 22h3v1h-3zM8 22h1v1h-1zM10 22h2v1h-2zM14 22h13v1h-13zM2 23h1v1h-1zM4 23h3v1h-3zM8 23h1v1h-1zM10 23h1v1h-1zM12 23h1v1h-1zM16 23h1v1h-1zM19 23h2v1h-2zM22 23h1v1h-1zM24 23h3v1h-3zM2 24h1v1h-1zM4 24h3v1h-3zM8 24h1v1h-1zM10 24h2v1h-2zM